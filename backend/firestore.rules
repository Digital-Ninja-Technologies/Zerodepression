rules_version = '2';

// ZeroDepression anonymous counselling chat.
//
// Model
//   chats/{uid}                 one chat per anonymous visitor; the doc id IS the visitor's anonymous uid
//   chats/{uid}/messages/{id}   the conversation (sender: 'user' | 'counsellor')
//   counsellors/{email}         invite-only allow-list, managed by admins in /counsellor-admin/ (role: 'admin')
//   presence/{uid}              written by signed-in counsellors so visitors can see "online now": a heartbeat (lastSeen) while
//                               the inbox is open, and onlineUntil (at most 8 hours ahead) while their Online toggle is on
//   pushSubs/{uid}/devices/{id} a counsellor's Web Push subscriptions; only they can manage them, the alert sender reads them
//   notifications/{id}          written only by the server-side alert sender (admin SDK); closed to every client
//   contactRequests/{uid}       a visitor's optional "call me back" request (name + how to reach them); first counsellor to accept it wins
//   contactRequests/{uid}/private/details   the visitor's phone/email and note, readable only by the counsellor who accepted, deleted when they finish
//
// Visitors sign in anonymously (no email, no account). Counsellors sign in with an email link, and are
// let in only if their VERIFIED email has an active doc in /counsellors. Nothing can be deleted by clients;
// a TTL policy on `expireAt` removes old chats and messages.
service cloud.firestore {
  match /databases/{database}/documents {

    // ------------------------------------------------------------------ identity helpers
    function signedIn() { return request.auth != null; }

    function isAnon() {
      return signedIn() && request.auth.token.firebase.sign_in_provider == 'anonymous';
    }

    function hasVerifiedEmail() {
      return signedIn() && 'email' in request.auth.token && request.auth.token.email_verified == true;
    }

    function counsellorPath() {
      return /databases/$(database)/documents/counsellors/$(request.auth.token.email.lower());
    }

    function isCounsellor() {
      return hasVerifiedEmail() && exists(counsellorPath()) && get(counsellorPath()).data.active == true;
    }

    // Admins are counsellors whose allow-list doc has role == 'admin'. Docs without a role are plain counsellors.
    // The first admin is created by hand in the Firebase console.
    function isAdmin() {
      return isCounsellor() && get(counsellorPath()).data.get('role', 'counsellor') == 'admin';
    }

    // ------------------------------------------------------------------ validation helpers
    function boundedExpiry(t) {
      return t is timestamp && t > request.time && t <= request.time + duration.value(8, 'd');
    }

    // fields that changed between the stored and the incoming document
    function changed() { return request.resource.data.diff(resource.data).affectedKeys(); }

    // ------------------------------------------------------------------ allow-list
    match /counsellors/{email} {
      function validRole(r) { return r == 'counsellor' || r == 'admin'; }
      function validName(n) { return n is string && n.size() >= 1 && n.size() <= 40; }

      // A counsellor may read their own entry (display name, role). Admins may read the whole list.
      allow get: if (hasVerifiedEmail() && request.auth.token.email.lower() == email) || isAdmin();
      allow list: if isAdmin();

      // Admins add counsellors. The doc id is the lowercase email address.
      allow create: if isAdmin()
        && email == email.lower() && email.matches('^[^@/\\s]+@[^@/\\s]+\\.[^@/\\s]+$') && email.size() <= 254
        && request.resource.data.keys().hasOnly(['displayName', 'active', 'role', 'addedBy', 'addedAt'])
        && request.resource.data.keys().hasAll(['displayName', 'active', 'role', 'addedBy', 'addedAt'])
        && validName(request.resource.data.displayName)
        && request.resource.data.active == true
        && validRole(request.resource.data.role)
        && request.resource.data.addedBy == request.auth.token.email.lower()
        && request.resource.data.addedAt == request.time;

      // Admins rename, deactivate/reactivate and change the role. They cannot change their own active flag or
      // role (so the last admin can't lock everyone out). Nothing is ever deleted; deactivate instead.
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'active', 'role'])
        && validName(request.resource.data.displayName)
        && request.resource.data.active is bool
        && validRole(request.resource.data.get('role', 'counsellor'))
        && (email != request.auth.token.email.lower()
            || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName']));
      allow delete: if false;
    }

    // ------------------------------------------------------------------ presence
    match /presence/{uid} {
      allow read: if true;   // only timestamps keyed by a random uid

      // onlineUntil may be cleared, left as it was (a heartbeat), or set to a time in the next 8 hours.
      function onlineUntilOk() {
        let u = request.resource.data.get('onlineUntil', null);
        return u == null
          || (resource != null && u == resource.data.get('onlineUntil', null))
          || (u is timestamp && u > request.time && u <= request.time + duration.value(481, 'm'));
      }

      allow create, update: if isCounsellor() && uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['lastSeen', 'onlineUntil'])
        && request.resource.data.lastSeen == request.time
        && onlineUntilOk();
      allow delete: if isCounsellor() && uid == request.auth.uid;
    }

    // ------------------------------------------------------------------ push subscriptions
    match /pushSubs/{uid}/devices/{deviceId} {
      allow read, delete: if isCounsellor() && uid == request.auth.uid;
      allow create, update: if isCounsellor() && uid == request.auth.uid
        && deviceId.size() <= 64
        && request.resource.data.keys().hasOnly(['endpoint', 'p256dh', 'auth', 'updatedAt'])
        && request.resource.data.keys().hasAll(['endpoint', 'p256dh', 'auth', 'updatedAt'])
        && request.resource.data.endpoint is string && request.resource.data.endpoint.matches('^https://.{8,800}$')
        && request.resource.data.p256dh is string && request.resource.data.p256dh.size() <= 200
        && request.resource.data.auth is string && request.resource.data.auth.size() <= 100
        && request.resource.data.updatedAt == request.time;
    }

    // ------------------------------------------------------------------ chats
    match /chats/{chatId} {

      function isOwner() { return isAnon() && resource.data.visitorUid == request.auth.uid; }
      function mine() { return isCounsellor() && resource.data.counsellorUid == request.auth.uid; }

      // Visitors read their own chat. Counsellors see waiting chats (the queue) and the chats they took.
      allow read: if isOwner()
        || (isCounsellor() && (resource.data.status == 'waiting' || resource.data.counsellorUid == request.auth.uid));

      // One chat per anonymous identity (doc id == uid), so spamming needs a new anonymous account each time.
      allow create: if isAnon() && chatId == request.auth.uid
        && request.resource.data.keys().hasOnly([
             'visitorUid', 'nickname', 'status', 'counsellorUid', 'counsellorName', 'crisis', 'preview',
             'msgCount', 'createdAt', 'lastActivity', 'visitorSeen', 'lastUserMsgAt',
             'claimedAt', 'closedAt', 'closedBy', 'expireAt'])
        && request.resource.data.keys().hasAll([
             'visitorUid', 'nickname', 'status', 'counsellorUid', 'counsellorName', 'crisis', 'preview',
             'msgCount', 'createdAt', 'lastActivity', 'visitorSeen', 'lastUserMsgAt',
             'claimedAt', 'closedAt', 'closedBy', 'expireAt'])
        && request.resource.data.visitorUid == request.auth.uid
        && request.resource.data.nickname is string
        && request.resource.data.nickname.size() >= 1 && request.resource.data.nickname.size() <= 24
        && request.resource.data.status == 'waiting'
        && request.resource.data.counsellorUid == null
        && request.resource.data.counsellorName == null
        && request.resource.data.crisis == false
        && request.resource.data.preview == ''
        && request.resource.data.msgCount == 0
        && request.resource.data.createdAt == request.time
        && request.resource.data.lastActivity == request.time
        && request.resource.data.visitorSeen == request.time
        && request.resource.data.lastUserMsgAt == request.time
        && request.resource.data.claimedAt == null
        && request.resource.data.closedAt == null
        && request.resource.data.closedBy == null
        && boundedExpiry(request.resource.data.expireAt);

      allow update: if

        // ---- visitor: keep-alive
        (isOwner() && resource.data.status != 'closed'
          && changed().hasOnly(['visitorSeen'])
          && request.resource.data.visitorSeen == request.time)

        // ---- visitor: send a message (batched with the message document)
        || (isOwner() && resource.data.status != 'closed'
          && changed().hasOnly(['msgCount', 'lastActivity', 'lastUserMsgAt', 'crisis', 'preview', 'visitorSeen', 'expireAt'])
          && request.resource.data.msgCount == resource.data.msgCount + 1
          && request.resource.data.msgCount <= 400
          && request.resource.data.lastActivity == request.time
          && request.resource.data.lastUserMsgAt == request.time
          && request.resource.data.visitorSeen == request.time
          && request.time > resource.data.lastUserMsgAt + duration.value(600, 'ms')   // throttle
          && (request.resource.data.crisis == resource.data.crisis || request.resource.data.crisis == true)
          && (request.resource.data.preview == resource.data.preview
              || (resource.data.preview == '' && request.resource.data.preview is string
                  && request.resource.data.preview.size() <= 140))
          && boundedExpiry(request.resource.data.expireAt))

        // ---- visitor: end the chat
        || (isOwner() && resource.data.status != 'closed'
          && changed().hasOnly(['status', 'closedAt', 'closedBy', 'lastActivity', 'expireAt'])
          && request.resource.data.status == 'closed'
          && request.resource.data.closedBy == 'user'
          && request.resource.data.closedAt == request.time
          && request.resource.data.lastActivity == request.time
          && boundedExpiry(request.resource.data.expireAt))

        // ---- counsellor: take a waiting chat (only one writer can win: status must still be 'waiting')
        || (isCounsellor() && resource.data.status == 'waiting'
          && changed().hasOnly(['status', 'counsellorUid', 'counsellorName', 'claimedAt', 'lastActivity'])
          && request.resource.data.status == 'active'
          && request.resource.data.counsellorUid == request.auth.uid
          && request.resource.data.counsellorName == get(counsellorPath()).data.displayName
          && request.resource.data.claimedAt == request.time
          && request.resource.data.lastActivity == request.time)

        // ---- counsellor: reply (batched with the message document)
        || (mine() && resource.data.status == 'active'
          && changed().hasOnly(['msgCount', 'lastActivity'])
          && request.resource.data.msgCount == resource.data.msgCount + 1
          && request.resource.data.msgCount <= 400
          && request.resource.data.lastActivity == request.time)

        // ---- counsellor: hand the chat back to the queue
        || (mine() && resource.data.status == 'active'
          && changed().hasOnly(['status', 'counsellorUid', 'counsellorName', 'claimedAt', 'lastActivity'])
          && request.resource.data.status == 'waiting'
          && request.resource.data.counsellorUid == null
          && request.resource.data.counsellorName == null
          && request.resource.data.claimedAt == null
          && request.resource.data.lastActivity == request.time)

        // ---- counsellor: end the chat
        || (mine() && resource.data.status == 'active'
          && changed().hasOnly(['status', 'closedAt', 'closedBy', 'lastActivity', 'expireAt'])
          && request.resource.data.status == 'closed'
          && request.resource.data.closedBy == 'counsellor'
          && request.resource.data.closedAt == request.time
          && request.resource.data.lastActivity == request.time
          && boundedExpiry(request.resource.data.expireAt));

      allow delete: if false;

      // -------------------------------------------------------------- messages
      match /messages/{msgId} {
        function chatDoc() { return get(/databases/$(database)/documents/chats/$(chatId)).data; }
        function chatAfter() { return getAfter(/databases/$(database)/documents/chats/$(chatId)).data; }

        function validBody() {
          return request.resource.data.body is string
            && request.resource.data.body.size() >= 1 && request.resource.data.body.size() <= 2000;
        }

        function shapeOk() {
          return request.resource.data.keys().hasOnly(['sender', 'body', 'createdAt', 'expireAt'])
            && request.resource.data.keys().hasAll(['sender', 'body', 'createdAt', 'expireAt'])
            && validBody()
            && request.resource.data.createdAt == request.time
            && boundedExpiry(request.resource.data.expireAt)
            // must be written in the same batch as the chat's msgCount increment
            && chatAfter().msgCount == chatDoc().msgCount + 1;
        }

        allow read: if (isAnon() && request.auth.uid == chatId)
          || (isCounsellor() && chatDoc().counsellorUid == request.auth.uid);

        allow create: if
          // visitor message
          (isAnon() && request.auth.uid == chatId && chatDoc().status != 'closed'
            && request.resource.data.sender == 'user' && shapeOk())
          // counsellor reply
          || (isCounsellor() && chatDoc().counsellorUid == request.auth.uid && chatDoc().status == 'active'
            && request.resource.data.sender == 'counsellor' && shapeOk());

        allow update, delete: if false;
      }
    }

    // ------------------------------------------------------------------ contact requests
    // A visitor can leave contact details instead of (or as well as) chatting. The queue entry holds only a name and
    // the preferred way to be reached; the phone number or email lives in a private sub-document that only the
    // counsellor who accepted the request can read. When that counsellor marks the request done, the details are deleted.
    match /contactRequests/{reqId} {
      function reqPath() { return /databases/$(database)/documents/contactRequests/$(reqId); }
      function detailsPath() { return /databases/$(database)/documents/contactRequests/$(reqId)/private/details; }
      function ownsReq() { return isAnon() && resource.data.visitorUid == request.auth.uid; }
      function mineReq() { return isCounsellor() && resource.data.claimedBy == request.auth.uid; }

      allow read: if ownsReq()
        || (isCounsellor() && (resource.data.status == 'new' || resource.data.claimedBy == request.auth.uid));

      // One request per anonymous identity (doc id == uid), written in the same batch as its private details.
      allow create: if isAnon() && reqId == request.auth.uid
        && request.resource.data.keys().hasOnly([
             'visitorUid', 'name', 'method', 'status', 'claimedBy', 'claimedByName', 'createdAt', 'claimedAt', 'doneAt', 'expireAt'])
        && request.resource.data.keys().hasAll([
             'visitorUid', 'name', 'method', 'status', 'claimedBy', 'claimedByName', 'createdAt', 'claimedAt', 'doneAt', 'expireAt'])
        && request.resource.data.visitorUid == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1 && request.resource.data.name.size() <= 40
        && request.resource.data.method in ['call', 'whatsapp', 'email']
        && request.resource.data.status == 'new'
        && request.resource.data.claimedBy == null
        && request.resource.data.claimedByName == null
        && request.resource.data.createdAt == request.time
        && request.resource.data.claimedAt == null
        && request.resource.data.doneAt == null
        && boundedExpiry(request.resource.data.expireAt)
        && existsAfter(detailsPath());

      allow update:
        // ---- counsellor: accept a new request (only one writer can win: status must still be 'new')
        if (isCounsellor() && resource.data.status == 'new'
          && changed().hasOnly(['status', 'claimedBy', 'claimedByName', 'claimedAt'])
          && request.resource.data.status == 'accepted'
          && request.resource.data.claimedBy == request.auth.uid
          && request.resource.data.claimedByName == get(counsellorPath()).data.displayName
          && request.resource.data.claimedAt == request.time)

        // ---- counsellor: hand it back to the queue
        || (mineReq() && resource.data.status == 'accepted'
          && changed().hasOnly(['status', 'claimedBy', 'claimedByName', 'claimedAt'])
          && request.resource.data.status == 'new'
          && request.resource.data.claimedBy == null
          && request.resource.data.claimedByName == null
          && request.resource.data.claimedAt == null)

        // ---- counsellor: mark followed up (the private details must be deleted in the same batch)
        || (mineReq() && resource.data.status == 'accepted'
          && changed().hasOnly(['status', 'doneAt'])
          && request.resource.data.status == 'done'
          && request.resource.data.doneAt == request.time
          && !existsAfter(detailsPath()));

      allow delete: if false;

      match /private/{docId} {
        allow read: if isCounsellor() && docId == 'details'
          && get(reqPath()).data.claimedBy == request.auth.uid
          && get(reqPath()).data.status == 'accepted';

        allow create: if isAnon() && docId == 'details' && reqId == request.auth.uid
          && !exists(reqPath()) && existsAfter(reqPath())
          && request.resource.data.keys().hasOnly(['contact', 'note', 'expireAt'])
          && request.resource.data.keys().hasAll(['contact', 'note', 'expireAt'])
          && request.resource.data.contact is string
          && request.resource.data.contact.size() >= 3 && request.resource.data.contact.size() <= 120
          && request.resource.data.note is string && request.resource.data.note.size() <= 500
          && boundedExpiry(request.resource.data.expireAt);

        allow update: if false;

        allow delete: if isCounsellor() && docId == 'details'
          && get(reqPath()).data.claimedBy == request.auth.uid
          && getAfter(reqPath()).data.status == 'done';
      }
    }

    // Everything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
